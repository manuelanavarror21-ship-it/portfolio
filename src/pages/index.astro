---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectsExplorer from '../components/ProjectsExplorer.astro';
import { services, experience, skills, education, contact } from '../data/profile';

const year = new Date().getFullYear();
---

<BaseLayout
  title="Manuela Navarro · Product, brand and graphic designer"
  description="Portfolio of Manuela Navarro, a digital product, brand and graphic designer based in Barcelona."
>
  <SiteHeader />
  <main id="main">
    <Hero />

    <ProjectsExplorer />

    <Section id="services" title="Services">
      <ul class="services">
        {
          services.map((service) => (
            <li class="service">
              <h3 class="service__title">{service.title}</h3>
              <p class="service__text">{service.description}</p>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="about" title="About me">
      <div class="about">
        <div class="about__block">
          <h3 class="label">Experience</h3>
          <dl class="timeline">
            {
              experience.map((job) => (
                <div class="timeline__item">
                  <dt>
                    <span class="timeline__name">{job.company}</span>
                    <span class="timeline__period">{job.period}</span>
                  </dt>
                  <dd>{job.description}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="about__block">
          <h3 class="label">Skills</h3>
          <ul class="chips">
            {skills.map((skill) => <li>{skill}</li>)}
          </ul>
          <h3 class="label">Education</h3>
          <ul class="education">
            {
              education.map((item) => (
                <li>
                  <span class="timeline__period">{item.period}</span>
                  <span>{item.title}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Section>

    <Section id="contact" title="Let’s work together">
      <div class="contact">
        <p class="contact__lead">Tell me about your product, brand or project.</p>
        <a class="contact__email" href={`mailto:${contact.email}`}>{contact.email}</a>
        <ul class="contact__social">
          {
            contact.social.map((link) => (
              <li>
                <a class="tab-link" href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </Section>
  </main>

  <footer class="site-footer">
    <p class="label">© {year} Manuela Navarro</p>
    <a class="label" href="#top">Back to top</a>
  </footer>
</BaseLayout>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(24px, 3vw, 40px);
    background: var(--color-bg);
  }

  .service__title {
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 500;
  }

  .service__text,
  .timeline dd,
  .contact__lead {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px clamp(32px, 6vw, 96px);
  }

  .about__block {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin: 0;
  }

  .timeline__item dt {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 6px;
  }

  .timeline dd {
    margin: 0;
    max-width: 52ch;
  }

  .timeline__name {
    font-size: 1.375rem;
    font-weight: 500;
  }

  .timeline__period {
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 8px 14px;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    font-size: 1rem;
  }

  .education {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.0625rem;
  }

  .education li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact__email {
    font-size: clamp(1.125rem, 0.2rem + 4.4vw, 4rem);
    font-weight: 300;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
  }

  .contact__email:hover {
    text-decoration-thickness: 2px;
  }

  .contact__social {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tab-link {
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding: 12px 16px;
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  .tab-link:hover {
    border-color: var(--color-ink);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding: 32px var(--gutter);
    border-top: 1px solid var(--color-line);
  }

  .site-footer a {
    text-decoration: none;
  }
</style>
