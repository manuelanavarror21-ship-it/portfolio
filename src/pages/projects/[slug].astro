---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, formatPeriod, type Project } from '../../lib/projects';

// Layout from Manuela's Figma frames 1891-11725 (desktop) and 1891-13069 (mobile):
// title, badges, dates, description and the live link on the left, held in
// place while the images and videos scroll past on the right.
export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Until a draft has its own images, its cover stands in so the page can be reviewed.
const media = data.media.length > 0 ? data.media : [{ image: data.cover, alt: data.coverAlt }];
const sizes = '(min-width: 1024px) 60vw, calc(100vw - 32px)';
---

<BaseLayout
  title={`${data.title} · Manuela Navarro`}
  description={data.summary}
  noindex={data.draft}
>
  <main id="main" class="project">
    <header class="project__info">
      <div class="project__heading">
        <a class="back" href="/#projects" aria-label="Back to all projects">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 2.5 4.5 8l5.5 5.5" stroke="currentColor" stroke-width="1.25"></path>
          </svg>
        </a>
        <h1 class="project__title">{data.title}</h1>
      </div>

      <div class="project__meta">
        <ul class="project__badges" aria-label="Disciplines">
          {data.badges.map((badge) => <li class="badge">{badge}</li>)}
        </ul>
        <p class="project__period">{formatPeriod(data)}</p>
      </div>

      <div class="project__description">
        <Content />
      </div>

      {
        data.link && (
          <a class="visit" href={data.link} target="_blank" rel="noopener noreferrer">
            Visit site
            <span class="visually-hidden"> (opens in a new tab)</span>
            <svg width="51" height="16" viewBox="0 0 51 16" fill="none" aria-hidden="true">
              <path d="M0 8h49M42 1l7 7-7 7" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </a>
        )
      }
    </header>

    <ul class="project__media" aria-label={`${data.title} images`}>
      {
        media.map((item, i) => (
          <li class="media">
            {'image' in item ? (
              <Image
                src={item.image}
                alt={item.alt}
                widths={[640, 1280, 1920, 2560]}
                sizes={sizes}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="media__asset"
              />
            ) : (
              <video
                class="media__asset"
                src={item.video}
                poster={item.poster?.src}
                aria-label={item.alt}
                autoplay
                muted
                loop
                playsinline
                preload={i === 0 ? 'auto' : 'metadata'}
              />
            )}
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 40px 16px 48px;
  }

  @media (min-width: 1024px) {
    .project {
      display: grid;
      grid-template-columns: minmax(300px, 383fr) minmax(0, 765fr);
      column-gap: 44px;
      align-items: start;
      padding: 44px;
    }
  }

  .project__info {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (min-width: 1024px) {
    .project__info {
      position: sticky;
      top: 44px;
    }
  }

  .project__heading {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .back {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-ink);
    transition: background-color 150ms ease, color 150ms ease;
  }

  .back:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .project__title {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: -4px;
  }

  .project__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .badge {
    padding: 4px 8px;
    background: #e0e0e0;
    color: var(--color-ink-soft);
    font-size: 0.875rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .project__period {
    font-size: 1rem;
    font-weight: 300;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .project__description {
    display: flex;
    flex-direction: column;
    gap: 1em;
    font-size: 1rem;
    font-weight: 200;
    line-height: 1.3;
  }

  .visit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    border: 1px solid var(--color-ink);
    background: var(--color-bg);
    font-size: 1.125rem;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .visit svg {
    flex-shrink: 0;
    transition: transform 150ms ease;
  }

  .visit:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .visit:hover svg {
    transform: translateX(4px);
  }

  .project__media {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .media {
      border-radius: 16px;
    }
  }

  .media__asset {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .back,
    .visit,
    .visit svg {
      transition: none;
    }
  }
</style>
