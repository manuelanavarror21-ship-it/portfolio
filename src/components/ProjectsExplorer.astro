---
import { Image } from 'astro:assets';
import { getProjects, formatPeriod, projectUrl } from '../lib/projects';

const projects = await getProjects();

// Layout from Manuela's Figma frames 1886-22934 (desktop) and 1886-23784 (mobile):
// the project list on the left, the selected project's cover on the right.
// Hovering, focusing or clicking a project in the list shows its cover, and the
// cover links to the project's page once it is no longer a draft.
---

<section class="explorer" id="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="explorer__title">My projects</h2>

  <div class="explorer__list" role="tablist" aria-orientation="vertical" aria-label="Projects">
    {
      projects.map(({ data: project }, i) => (
        <button
          type="button"
          class="project-tab"
          role="tab"
          id={`project-tab-${i}`}
          aria-controls={`project-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-index={i}
        >
          <span>{project.title}</span>
          <svg class="project-tab__arrow" width="64" height="16" viewBox="0 0 64 16" fill="none" aria-hidden="true">
            <path d="M0 8h62M55 1l7 7-7 7" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
      ))
    }
  </div>

  <div class="explorer__panels">
    {
      projects.map((entry, i) => {
        const project = entry.data;
        const Stage = project.draft ? 'div' : 'a';
        const link = project.draft ? {} : { href: projectUrl(entry), 'aria-label': `View the ${project.title} project` };
        return (
          <figure
            class="project-panel"
            role="tabpanel"
            id={`project-panel-${i}`}
            aria-labelledby={`project-tab-${i}`}
            hidden={i !== 0}
          >
            <Stage class="project-panel__stage" {...link}>
              <Image
                src={project.cover}
                alt={project.coverAlt}
                widths={[640, 1280, 1920, 2560]}
                sizes="(min-width: 1024px) 64vw, calc(100vw - 32px)"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="project-panel__image"
              />
            </Stage>
            <figcaption class="project-panel__meta">
              <span class="project-panel__tags">
                {project.badges.map((badge) => <span class="chip">{badge}</span>)}
              </span>
              <span class="project-panel__period">{formatPeriod(project)}</span>
            </figcaption>
          </figure>
        );
      })
    }
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.project-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.project-panel'));

  function select(index: number, focus = false) {
    tabs.forEach((tab, i) => {
      const active = i === index;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      panels[i].hidden = !active;
    });
    if (focus) tabs[index].focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i));
    tab.addEventListener('focus', () => select(i));
    tab.addEventListener('mouseenter', () => {
      if (window.matchMedia('(hover: hover)').matches) select(i);
    });
    tab.addEventListener('keydown', (event) => {
      const last = tabs.length - 1;
      const next: Record<string, number> = {
        ArrowDown: i === last ? 0 : i + 1,
        ArrowUp: i === 0 ? last : i - 1,
        Home: 0,
        End: last,
      };
      if (event.key in next) {
        event.preventDefault();
        select(next[event.key], true);
      }
    });
  });
</script>

<style>
  .explorer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'title'
      'panels'
      'list';
    gap: 24px;
    padding: 16px 16px 48px;
  }

  @media (min-width: 1024px) {
    .explorer {
      grid-template-columns: minmax(280px, 383fr) minmax(0, 765fr);
      grid-template-areas:
        'title panels'
        'list panels';
      grid-template-rows: auto 1fr;
      column-gap: 44px;
      align-items: start;
      height: 100svh;
      min-height: 640px;
      padding: 44px 44px calc(var(--nav-height) + 24px);
    }
  }

  .explorer__title {
    grid-area: title;
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  /* The list scrolls on its own, so the selected cover stays in view. */
  .explorer__list {
    grid-area: list;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 0;
    max-height: min(50svh, 342px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
  }

  @media (min-width: 1024px) {
    .explorer__list {
      align-self: stretch;
      max-height: none;
    }
  }

  .project-tab {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: 1.125rem;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .project-tab__arrow {
    flex-shrink: 0;
    width: 51px;
    height: 16px;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 150ms ease, transform 150ms ease;
  }

  .project-tab[aria-selected='true'] {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .project-tab[aria-selected='true'] .project-tab__arrow {
    opacity: 1;
    transform: none;
  }

  .explorer__panels {
    grid-area: panels;
    min-width: 0;
  }

  .project-panel {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
  }

  .project-panel[hidden] {
    display: none;
  }

  .project-panel__stage {
    display: block;
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    background: var(--color-ink);
  }

  .project-panel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-panel__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .project-panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip,
  .project-panel__period {
    font-size: 1rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 639px) {
    .chip,
    .project-panel__period {
      font-size: 0.875rem;
      letter-spacing: 0.1em;
    }
  }

  .project-panel__period {
    white-space: nowrap;
  }

  .chip {
    padding: 2px 8px;
    background: #e3e3e3;
  }

  .project-panel__period {
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-tab,
    .project-tab__arrow {
      transition: none;
    }
  }
</style>
