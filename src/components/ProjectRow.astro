---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project">
  <div
    class:list={['project__stage', `project__stage--${project.fit}`]}
    style={`--stage: ${project.stage}; --position: ${project.position ?? 'center'}`}
  >
    <Image
      src={project.image}
      alt={project.imageAlt}
      widths={[640, 1024]}
      sizes="(min-width: 1440px) 1184px, calc(100vw - 2 * var(--gutter))"
      class="project__image"
    />
  </div>
  <div class="project__caption">
    <h3 class="project__title">{project.title}</h3>
    <p class="project__meta">
      <span>{project.tags.join(' · ')}</span>
      <span class="project__period">{project.period}</span>
    </p>
    <p class="project__summary">{project.summary}</p>
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .project__stage {
    aspect-ratio: 16 / 9;
    max-width: 100%;
    overflow: hidden;
    background: var(--stage);
    border: 1px solid var(--color-line);
  }

  .project__image {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .project__stage {
      aspect-ratio: 4 / 3;
    }
  }

  .project__stage--cover .project__image {
    object-fit: cover;
    object-position: var(--position);
  }

  .project__stage--contain {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 56px);
  }

  .project__stage--contain .project__image {
    object-fit: contain;
  }

  .project__caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
  }

  @media (min-width: 900px) {
    .project__caption {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      column-gap: 48px;
      align-items: baseline;
    }

    .project__summary {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  .project__title {
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 0.875rem;
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .project__period {
    font-variant-numeric: tabular-nums;
  }

  .project__summary {
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
</style>
